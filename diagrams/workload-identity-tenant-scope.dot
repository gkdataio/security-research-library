digraph diagram {
rankdir=TB;
graph [bgcolor="white", pad="0.35", ranksep="0.65", nodesep="0.5", fontname="DejaVu Sans", fontsize=20, labelloc=t, label="Keep workload authority tenant-scoped"];
node [fontname="DejaVu Sans", fontsize=13, style="rounded,filled", color="#64748b", fillcolor="#f1f5f9", fontcolor="#172033", margin="0.20,0.16"];
edge [fontname="DejaVu Sans", fontsize=11, color="#64748b", fontcolor="#334155"];
"identity" [label="Verified workload identity\nand tenant context", shape="box", fillcolor="#f1f5f9"];
"request" [label="Requested action and\nresource", shape="box", fillcolor="#f1f5f9"];
"policy" [label="Do role, action, resource\nand tenant match policy?", shape="diamond", fillcolor="#e0ecf8"];
"allow" [label="Allow only the approved\nresource scope", shape="box", fillcolor="#dcfce7"];
"deny" [label="Deny access", shape="box", fillcolor="#fef3c7"];
"audit" [label="Record the authorization\ndecision", shape="box", fillcolor="#f1f5f9"];
"identity" -> "policy" [label="Verified context"];
"request" -> "policy" [label="Operation"];
"policy" -> "allow" [label="Yes"];
"policy" -> "deny" [label="No"];
"allow" -> "audit" [label=""];
"deny" -> "audit" [label=""];
}
