digraph diagram {
rankdir=TB;
graph [bgcolor="white", pad="0.35", ranksep="0.65", nodesep="0.5", fontname="DejaVu Sans", fontsize=20, labelloc=t, label="An identity claim must belong to the user"];
node [fontname="DejaVu Sans", fontsize=13, style="rounded,filled", color="#64748b", fillcolor="#f1f5f9", fontcolor="#172033", margin="0.20,0.16"];
edge [fontname="DejaVu Sans", fontsize=11, color="#64748b", fontcolor="#334155"];
"subject" [label="Authenticated subject", shape="box", fillcolor="#f1f5f9"];
"claims" [label="Issue claims bound to that\nsubject", shape="box", fillcolor="#f1f5f9"];
"validate" [label="Valid issuer, audience,\nsignature and subject\nbinding?", shape="diamond", fillcolor="#e0ecf8"];
"account" [label="Map to the authorized local\naccount", shape="box", fillcolor="#dcfce7"];
"reject" [label="Reject inconsistent\nidentity claims", shape="box", fillcolor="#fef3c7"];
"subject" -> "claims" [label=""];
"claims" -> "validate" [label=""];
"validate" -> "account" [label="Yes"];
"validate" -> "reject" [label="No"];
}
