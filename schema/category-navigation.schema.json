{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "categories"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "resource_topic_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "kind": {
            "enum": [
              "vulnerability_family",
              "security_theme"
            ]
          },
          "resource_topic_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "resource_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "description": "Explicit related-learning records; does not reclassify resources or reports."
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "categories": {
          "items": {
            "properties": {
              "resource_ids": {
                "const": []
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "schema_version": {
          "const": "1.1.0"
        }
      }
    }
  ]
}
