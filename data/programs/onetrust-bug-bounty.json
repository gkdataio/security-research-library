      "policy",
      "platform-terms"
    ]
  },
  "restrictions": {
    "summary": "Use assigned or self-created accounts in the designated staging environment. Avoid shared-setting changes and disruption. Social engineering is prohibited. Public disclosure is prohibited; safe harbor is conditional.",
